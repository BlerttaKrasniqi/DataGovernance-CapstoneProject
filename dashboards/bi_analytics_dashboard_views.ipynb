    "-- Governance Compliance Summary\n",
    "-- Calculates compliant and non-compliant metadata records.\n",
    "-- Provides total records, compliance rate percentage,\n",
    "-- and non-compliance rate percentage.\n",
    "CREATE OR REPLACE VIEW dashboard_reporting.vw_governance_compliance_summary AS\n",
    "SELECT\n",
    "    compliant_records,\n",
    "    non_compliant_records,\n",
    "    compliant_records + non_compliant_records AS total_records,\n",
    "\n",
    "    ROUND(\n",
    "        CASE\n",
    "            WHEN compliant_records + non_compliant_records = 0 THEN 0\n",
    "            ELSE compliant_records * 100.0 / (compliant_records + non_compliant_records)\n",
    "        END,\n",
    "        2\n",
    "    ) AS compliance_rate_percentage,\n",
    "\n",
    "    ROUND(\n",
    "        CASE\n",
    "            WHEN compliant_records + non_compliant_records = 0 THEN 0\n",
    "            ELSE non_compliant_records * 100.0 / (compliant_records + non_compliant_records)\n",
    "        END,\n",
    "        2\n",
    "    ) AS non_compliance_rate_percentage\n",
    "FROM (\n",
    "    SELECT\n",
    "        (SELECT COUNT(*) FROM default.gold_compliant_metadata) AS compliant_records,\n",
    "        (SELECT COUNT(*) FROM default.gold_non_compliant_metadata) AS non_compliant_records\n",
    ");"
    ");\n",
    "SELECT *\n",
    "FROM dashboard_reporting.vw_governance_compliance_summary;"
   ]
  },
