   "source": [
    "-- Splits metadata records into PII and Non-PII categories.\n",
    "-- Calculates the count of PII records and remaining non-PII records.\n",
    "-- Used for the PII vs Non-PII Record\n",
    "CREATE OR REPLACE VIEW dashboard_reporting.vw_pii_distribution AS\n",
    "SELECT\n",
    "    'PII Records' AS pii_status,\n",
    "    (SELECT COUNT(*) FROM default.gold_pii_metadata) AS record_count\n",
    "\n",
    "UNION ALL\n",
    "\n",
    "SELECT\n",
    "    'Non-PII Records' AS pii_status,\n",
    "    (\n",
    "        (SELECT COUNT(*) FROM default.gold_classified_metadata)\n",
    "        -\n",
    "        (SELECT COUNT(*) FROM default.gold_pii_metadata)\n",
    "    ) AS record_count;"
    "    ) AS record_count;\n",
    "SELECT *\n",
    "FROM dashboard_reporting.vw_pii_distribution;"
   ]
  },
