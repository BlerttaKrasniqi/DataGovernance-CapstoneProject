    "-- Metadata Validation Breakdown\n",
    "-- Shows passed and failed counts for each metadata validation check.\n",
    "-- Used for the Metadata Completeness bar/stacked bar chart.\n",
    "CREATE OR REPLACE VIEW dashboard_reporting.vw_metadata_validation_breakdown AS\n",
    "SELECT 'Table Description' AS validation_check,\n",
    "       SUM(CASE WHEN COALESCE(flag_table_desc, 0) = 1 THEN 1 ELSE 0 END) AS passed_count,\n",
    "       SUM(CASE WHEN COALESCE(flag_table_desc, 0) = 0 THEN 1 ELSE 0 END) AS failed_count\n",
    "FROM default.gold_quality_metrics\n",
    "\n",
    "UNION ALL\n",
    "\n",
    "SELECT 'Column Description' AS validation_check,\n",
    "       SUM(CASE WHEN COALESCE(flag_column_desc, 0) = 1 THEN 1 ELSE 0 END) AS passed_count,\n",
    "       SUM(CASE WHEN COALESCE(flag_column_desc, 0) = 0 THEN 1 ELSE 0 END) AS failed_count\n",
    "FROM default.gold_quality_metrics\n",
    "\n",
    "UNION ALL\n",
    "\n",
    "SELECT 'Business Term' AS validation_check,\n",
    "       SUM(CASE WHEN COALESCE(flag_term_name, 0) = 1 THEN 1 ELSE 0 END) AS passed_count,\n",
    "       SUM(CASE WHEN COALESCE(flag_term_name, 0) = 0 THEN 1 ELSE 0 END) AS failed_count\n",
    "FROM default.gold_quality_metrics\n",
    "\n",
    "UNION ALL\n",
    "\n",
    "SELECT 'Data Steward' AS validation_check,\n",
    "       SUM(CASE WHEN COALESCE(flag_data_steward, 0) = 1 THEN 1 ELSE 0 END) AS passed_count,\n",
    "       SUM(CASE WHEN COALESCE(flag_data_steward, 0) = 0 THEN 1 ELSE 0 END) AS failed_count\n",
    "FROM default.gold_quality_metrics\n",
    "\n",
    "UNION ALL\n",
    "\n",
    "SELECT 'Security Classification' AS validation_check,\n",
    "       SUM(CASE WHEN COALESCE(flag_security_classification, 0) = 1 THEN 1 ELSE 0 END) AS passed_count,\n",
    "       SUM(CASE WHEN COALESCE(flag_security_classification, 0) = 0 THEN 1 ELSE 0 END) AS failed_count\n",
    "FROM default.gold_quality_metrics\n",
    "\n",
    "UNION ALL\n",
    "\n",
    "SELECT 'Source System Tag' AS validation_check,\n",
    "       SUM(CASE WHEN COALESCE(flag_source_system_tag, 0) = 1 THEN 1 ELSE 0 END) AS passed_count,\n",
    "       SUM(CASE WHEN COALESCE(flag_source_system_tag, 0) = 0 THEN 1 ELSE 0 END) AS failed_count\n",
    "FROM default.gold_quality_metrics\n",
    "\n",
    "UNION ALL\n",
    "\n",
    "SELECT 'PII Flag' AS validation_check,\n",
    "       SUM(CASE WHEN COALESCE(flag_pii_flag, 0) = 1 THEN 1 ELSE 0 END) AS passed_count,\n",
    "       SUM(CASE WHEN COALESCE(flag_pii_flag, 0) = 0 THEN 1 ELSE 0 END) AS failed_count\n",
    "FROM default.gold_quality_metrics\n",
    "\n",
    "UNION ALL\n",
    "\n",
    "SELECT 'Data Quality Pass' AS validation_check,\n",
    "       SUM(CASE WHEN COALESCE(flag_dq_pass, 0) = 1 THEN 1 ELSE 0 END) AS passed_count,\n",
    "       SUM(CASE WHEN COALESCE(flag_dq_pass, 0) = 0 THEN 1 ELSE 0 END) AS failed_count\n",
    "FROM default.gold_quality_metrics;"
    "FROM default.gold_quality_metrics;\n",
    "\n",
    "SELECT *\n",
    "FROM dashboard_reporting.vw_metadata_validation_breakdown;"
   ]
