   "source": [
    "-- Shows total, valid, and invalid records,\n",
    "-- average quality score, and quality status.\n",
    "-- Used for the Data Quality\n",
    "CREATE OR REPLACE VIEW dashboard_reporting.vw_data_quality_details AS\n",
    "SELECT\n",
    "    table_name,\n",
    "    COUNT(*) AS total_records,\n",
    "    SUM(CASE WHEN COALESCE(flag_dq_pass, 0) = 1 THEN 1 ELSE 0 END) AS valid_records,\n",
    "    SUM(CASE WHEN COALESCE(flag_dq_pass, 0) = 0 THEN 1 ELSE 0 END) AS invalid_records,\n",
    "    ROUND(AVG(quality_score), 2) AS average_quality_score,\n",
    "\n",
    "    CASE\n",
    "        WHEN AVG(quality_score) >= 90 THEN 'Excellent'\n",
    "        WHEN AVG(quality_score) >= 75 THEN 'Good'\n",
    "        WHEN AVG(quality_score) >= 50 THEN 'Medium'\n",
    "        ELSE 'Poor'\n",
    "    END AS quality_status\n",
    "FROM default.gold_quality_metrics\n",
    "GROUP BY table_name;"
    "GROUP BY table_name;\n",
    "\n",
    "SELECT *\n",
    "FROM dashboard_reporting.vw_data_quality_details\n",
    "ORDER BY average_quality_score DESC;"
   ]
  },
