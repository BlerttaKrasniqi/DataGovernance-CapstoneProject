    "-- Counts metadata records by assigned data owner.\n",
    "-- Used to show ownership and accountability across metadata assets.\n",
    "-- Used for the Data Ownership Distribution \n",
    "CREATE OR REPLACE VIEW dashboard_reporting.vw_data_ownership_distribution AS\n",
    "SELECT\n",
    "    data_owner,\n",
    "    COUNT(*) AS record_count\n",
    "FROM default.gold_data_ownership_registry\n",
    "GROUP BY data_owner;"
    "GROUP BY data_owner;\n",
    "SELECT *\n",
    "FROM dashboard_reporting.vw_data_ownership_distribution\n",
    "ORDER BY record_count DESC;"
   ]
  },
