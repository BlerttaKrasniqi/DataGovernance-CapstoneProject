   "source": [
    "-- Groups metadata records into quality score categories:\n",
    "-- Excellent, Good, Medium, or Poor.\n",
    "-- Used for the Quality Score\n",
    "CREATE OR REPLACE VIEW dashboard_reporting.vw_quality_score_buckets AS\n",
    "SELECT\n",
    "    CASE\n",
    "        WHEN quality_score >= 90 THEN 'Excellent (90-100)'\n",
    "        WHEN quality_score >= 75 THEN 'Good (75-89)'\n",
    "        WHEN quality_score >= 50 THEN 'Medium (50-74)'\n",
    "        ELSE 'Poor (<50)'\n",
    "    END AS quality_bucket,\n",
    "    COUNT(*) AS record_count\n",
    "FROM default.gold_quality_metrics\n",
    "GROUP BY\n",
    "    CASE\n",
    "        WHEN quality_score >= 90 THEN 'Excellent (90-100)'\n",
    "        WHEN quality_score >= 75 THEN 'Good (75-89)'\n",
    "        WHEN quality_score >= 50 THEN 'Medium (50-74)'\n",
    "        ELSE 'Poor (<50)'\n",
    "    END;"
    "    END;\n",
    "SELECT *\n",
    "FROM dashboard_reporting.vw_quality_score_buckets;"
   ]
  },
