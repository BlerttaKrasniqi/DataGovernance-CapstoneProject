   "source": [
    "-- Calculates total, valid, and invalid metadata records.\n",
    "-- Provides average quality score and validation success rate.\n",
    "-- Used for Data Quality.\n",
    "CREATE OR REPLACE VIEW dashboard_reporting.vw_data_quality_summary AS\n",
    "SELECT\n",
    "    COUNT(*) AS total_metadata_records,\n",
    "\n",
    "    SUM(CASE WHEN COALESCE(flag_dq_pass, 0) = 1 THEN 1 ELSE 0 END) AS valid_records,\n",
    "\n",
    "    SUM(CASE WHEN COALESCE(flag_dq_pass, 0) = 0 THEN 1 ELSE 0 END) AS invalid_records,\n",
    "\n",
    "    ROUND(AVG(quality_score), 2) AS average_quality_score,\n",
    "\n",
    "    ROUND(\n",
    "        CASE\n",
    "            WHEN COUNT(*) = 0 THEN 0\n",
    "            ELSE SUM(CASE WHEN COALESCE(flag_dq_pass, 0) = 1 THEN 1 ELSE 0 END) * 100.0 / COUNT(*)\n",
    "        END,\n",
    "        2\n",
    "    ) AS validation_success_rate\n",
    "FROM default.gold_quality_metrics;"
    "FROM default.gold_quality_metrics;\n",
    "\n",
    "SELECT *\n",
    "FROM dashboard_reporting.vw_data_quality_summary;"
   ]
  },
