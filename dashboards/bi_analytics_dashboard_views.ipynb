    "-- Metadata Completeness by Table\n",
    "-- Calculates metadata completeness percentage for each table.\n",
    "-- Includes total columns, passed checks, failed checks,\n",
    "-- and average quality score per table.\n",
    "CREATE OR REPLACE VIEW dashboard_reporting.vw_metadata_completeness_by_table AS\n",
    "SELECT\n",
    "    table_name,\n",
    "    COUNT(column_name) AS total_columns,\n",
    "\n",
    "    SUM(\n",
    "        COALESCE(flag_table_desc, 0) +\n",
    "        COALESCE(flag_column_desc, 0) +\n",
    "        COALESCE(flag_term_name, 0) +\n",
    "        COALESCE(flag_data_steward, 0) +\n",
    "        COALESCE(flag_security_classification, 0) +\n",
    "        COALESCE(flag_source_system_tag, 0) +\n",
    "        COALESCE(flag_pii_flag, 0) +\n",
    "        COALESCE(flag_dq_pass, 0)\n",
    "    ) AS passed_checks,\n",
    "\n",
    "    COUNT(*) * 8 -\n",
    "    SUM(\n",
    "        COALESCE(flag_table_desc, 0) +\n",
    "        COALESCE(flag_column_desc, 0) +\n",
    "        COALESCE(flag_term_name, 0) +\n",
    "        COALESCE(flag_data_steward, 0) +\n",
    "        COALESCE(flag_security_classification, 0) +\n",
    "        COALESCE(flag_source_system_tag, 0) +\n",
    "        COALESCE(flag_pii_flag, 0) +\n",
    "        COALESCE(flag_dq_pass, 0)\n",
    "    ) AS failed_checks,\n",
    "\n",
    "    ROUND(\n",
    "        SUM(\n",
    "            COALESCE(flag_table_desc, 0) +\n",
    "            COALESCE(flag_column_desc, 0) +\n",
    "            COALESCE(flag_term_name, 0) +\n",
    "            COALESCE(flag_data_steward, 0) +\n",
    "            COALESCE(flag_security_classification, 0) +\n",
    "            COALESCE(flag_source_system_tag, 0) +\n",
    "            COALESCE(flag_pii_flag, 0) +\n",
    "            COALESCE(flag_dq_pass, 0)\n",
    "        ) * 100.0 / (COUNT(*) * 8),\n",
    "        2\n",
    "    ) AS metadata_completeness_percentage,\n",
    "\n",
    "    ROUND(AVG(quality_score), 2) AS average_quality_score\n",
    "FROM default.gold_quality_metrics\n",
    "GROUP BY table_name;"
    "GROUP BY table_name;\n",
    "\n",
    "SELECT *\n",
    "FROM dashboard_reporting.vw_metadata_completeness_by_table\n",
    "ORDER BY metadata_completeness_percentage DESC;\n"
   ]
  },
