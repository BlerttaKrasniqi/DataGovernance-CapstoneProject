    "-- Metadata Completeness Details\n",
    "-- Provides detailed completeness metrics for each table.\n",
    "-- Shows completed and missing metadata fields,\n",
    "-- average quality score, and completeness status.\n",
    "CREATE OR REPLACE VIEW dashboard_reporting.vw_metadata_completeness_details AS\n",
    "SELECT\n",
    "    table_name,\n",
    "    COUNT(column_name) AS total_columns,\n",
    "\n",
    "    ROUND(AVG(quality_score), 2) AS average_quality_score,\n",
    "\n",
    "    SUM(CASE WHEN COALESCE(flag_table_desc, 0) = 1 THEN 1 ELSE 0 END) AS table_desc_completed,\n",
    "    SUM(CASE WHEN COALESCE(flag_column_desc, 0) = 1 THEN 1 ELSE 0 END) AS column_desc_completed,\n",
    "    SUM(CASE WHEN COALESCE(flag_term_name, 0) = 1 THEN 1 ELSE 0 END) AS business_term_completed,\n",
    "    SUM(CASE WHEN COALESCE(flag_data_steward, 0) = 1 THEN 1 ELSE 0 END) AS data_steward_completed,\n",
    "    SUM(CASE WHEN COALESCE(flag_security_classification, 0) = 1 THEN 1 ELSE 0 END) AS security_classification_completed,\n",
    "\n",
    "    SUM(CASE WHEN COALESCE(flag_table_desc, 0) = 0 THEN 1 ELSE 0 END) AS missing_table_desc,\n",
    "    SUM(CASE WHEN COALESCE(flag_column_desc, 0) = 0 THEN 1 ELSE 0 END) AS missing_column_desc,\n",
    "    SUM(CASE WHEN COALESCE(flag_term_name, 0) = 0 THEN 1 ELSE 0 END) AS missing_business_term,\n",
    "    SUM(CASE WHEN COALESCE(flag_data_steward, 0) = 0 THEN 1 ELSE 0 END) AS missing_data_steward,\n",
    "    SUM(CASE WHEN COALESCE(flag_security_classification, 0) = 0 THEN 1 ELSE 0 END) AS missing_security_classification,\n",
    "\n",
    "    CASE\n",
    "        WHEN AVG(quality_score) >= 90 THEN 'High Completeness'\n",
    "        WHEN AVG(quality_score) >= 70 THEN 'Medium Completeness'\n",
    "        ELSE 'Low Completeness'\n",
    "    END AS completeness_status\n",
    "FROM default.gold_quality_metrics\n",
    "GROUP BY table_name;"
    "GROUP BY table_name;\n",
    "\n",
    "SELECT *\n",
    "FROM dashboard_reporting.vw_metadata_completeness_details\n",
    "ORDER BY average_quality_score DESC;"
   ]
  },
