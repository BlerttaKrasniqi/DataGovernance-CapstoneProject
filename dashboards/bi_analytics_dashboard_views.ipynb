    "-- Calculates the number of PII records,\n",
    "-- total classified records, and PII percentage.\n",
    "-- Used for PI\n",
    "CREATE OR REPLACE VIEW dashboard_reporting.vw_pii_summary AS\n",
    "SELECT\n",
    "    pii_records,\n",
    "    total_records,\n",
    "\n",
    "    ROUND(\n",
    "        CASE\n",
    "            WHEN total_records = 0 THEN 0\n",
    "            ELSE pii_records * 100.0 / total_records\n",
    "        END,\n",
    "        2\n",
    "    ) AS pii_percentage\n",
    "FROM (\n",
    "    SELECT\n",
    "        (SELECT COUNT(*) FROM default.gold_pii_metadata) AS pii_records,\n",
    "        (SELECT COUNT(*) FROM default.gold_classified_metadata) AS total_records\n",
    ");"
    ");\n",
    "\n",
    "SELECT *\n",
    "FROM dashboard_reporting.vw_pii_summary;"
   ]
  },
