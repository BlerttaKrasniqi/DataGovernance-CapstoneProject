    "-- Governance Compliance Summary\n",
    "-- Lists metadata records with compliance status,\n",
    "-- governance status, priority level, and PII flag.\n",
    "-- Sorted by priority to highlight high-priority records first.\n",
    "CREATE OR REPLACE VIEW dashboard_reporting.vw_governance_review_details AS\n",
    "SELECT\n",
    "    table_name,\n",
    "    column_name,\n",
    "    is_compliant,\n",
    "    governance_status,\n",
    "    metadata_priority,\n",
    "    pii_flag\n",
    "FROM default.gold_enriched_metadata\n",
    "ORDER BY\n",
    "    CASE\n",
    "        WHEN metadata_priority = 'High' THEN 1\n",
    "        WHEN metadata_priority = 'Medium' THEN 2\n",
    "        ELSE 3\n",
    "    END,\n",
    "    table_name,\n",
    "    column_name;"
    "    column_name;\n",
    "SELECT *\n",
    "FROM dashboard_reporting.vw_governance_review_details;"
   ]
  },
