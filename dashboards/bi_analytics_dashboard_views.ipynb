   "source": [
    "-- Identifies potentially sensitive metadata fields\n",
    "-- based on column name patterns such as email, phone,\n",
    "-- ssn, account, and birth.\n",
    "-- Adds sensitivity category and detection reason.\n",
    "-- Used for the PII & Sensitive Metadata \n",
    "CREATE OR REPLACE VIEW dashboard_reporting.vw_pii_sensitive_metadata_details AS\n",
    "SELECT\n",
    "    table_name,\n",
    "    column_name,\n",
    "    pii_flag,\n",
    "\n",
    "    CASE\n",
    "        WHEN LOWER(column_name) LIKE '%ssn%' THEN 'Highly Sensitive'\n",
    "        WHEN LOWER(column_name) LIKE '%account%' THEN 'Sensitive'\n",
    "        WHEN LOWER(column_name) LIKE '%birth%' THEN 'Sensitive'\n",
    "        WHEN LOWER(column_name) LIKE '%email%' THEN 'PII'\n",
    "        WHEN LOWER(column_name) LIKE '%phone%' THEN 'PII'\n",
    "        ELSE 'Potentially Sensitive'\n",
    "    END AS sensitivity_category,\n",
    "\n",
    "    CASE\n",
    "        WHEN LOWER(column_name) LIKE '%ssn%' THEN 'Contains social security identifier'\n",
    "        WHEN LOWER(column_name) LIKE '%account%' THEN 'Contains account-related information'\n",
    "        WHEN LOWER(column_name) LIKE '%birth%' THEN 'Contains date of birth information'\n",
    "        WHEN LOWER(column_name) LIKE '%email%' THEN 'Can identify a person through email'\n",
    "        WHEN LOWER(column_name) LIKE '%phone%' THEN 'Can identify a person through phone number'\n",
    "        ELSE 'Detected as potentially sensitive based on column name'\n",
    "    END AS detection_reason\n",
    "\n",
    "FROM default.gold_classified_metadata\n",
    "WHERE\n",
    "    LOWER(column_name) LIKE '%email%'\n",
    "    OR LOWER(column_name) LIKE '%phone%'\n",
    "    OR LOWER(column_name) LIKE '%ssn%'\n",
    "    OR LOWER(column_name) LIKE '%account%'\n",
    "    OR LOWER(column_name) LIKE '%birth%';"
    "    OR LOWER(column_name) LIKE '%birth%';\n",
    "SELECT *\n",
    "FROM dashboard_reporting.vw_pii_sensitive_metadata_details\n",
    "ORDER BY sensitivity_category, table_name, column_name;"
   ]
  },
